{
  "name": "overhead-ai",
  "version": "0.2.0",
  "description": "Token cost attribution across a monorepo — attribute AI API spend to directories, packages, and teams.",
  "type": "module",
  "bin": {
    "overhead": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "overhead": "node --no-warnings src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "cost",
    "attribution",
    "monorepo",
    "finops",
    "anthropic",
    "claude",
    "observability"
  ],
  "author": "Nicolas Dunlap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndunl075/overhead.git"
  },
  "bugs": {
    "url": "https://github.com/ndunl075/overhead/issues"
  },
  "homepage": "https://github.com/ndunl075/overhead#readme",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
